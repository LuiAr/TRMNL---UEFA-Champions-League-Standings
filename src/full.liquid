<div class="layout layout--col layout--top gap--none pt--2">
  {%- if error == 1 or count == 0 -%}
    <div class="layout layout--center h--full">
      <span class="title">{{ error_message | default: 'Standings unavailable' }}</span>
    </div>
  {%- else -%}
    {%- comment -%}
      Two columns in every orientation, deliberately. portrait:grid--cols-1 was tested and
      rejected: stacking the two 18-row tables clips ranks 30-36 behind the title bar on
      TRMNL X portrait. Two columns fit all 36 in both orientations with room to spare, and
      gap--large already applies in portrait, so portrait:gap--large would be redundant.
    {%- endcomment -%}
    <div class="grid grid--cols-2 gap--large">

      <div>
        <table class="table table--xsmall lg:table--small">
          <thead>
            <tr>
              <th class="w--6"><span class="label label--small text--gray-40">#</span></th>
              <th><span class="label label--small text--gray-40">Team</span></th>
              <th class="w--8"><span class="label label--small text--gray-40 text--right">P</span></th>
              <th class="w--10"><span class="label label--small text--gray-40 text--right">GD</span></th>
              <th class="w--10"><span class="label label--small text--gray-40 text--right">Pts</span></th>
            </tr>
          </thead>
          <tbody>
            {%- for row in teams limit: 18 -%}
            {%- comment -%} BEGIN rowvars — generated from src/_rowvars.inc, do not edit here {%- endcomment -%}
            {%- comment -%}
              Per-row presentation variables.
              Kept as assigns so no Liquid sits in an HTML tag-open or attribute position — the visual
              editor cannot round-trip that. Zone cut lines use the framework's border--top class on the
              first row of each new zone, so no custom CSS is needed.
            {%- endcomment -%}
            {%- assign is_fav = false -%}
            {%- if row.fv == 1 -%}{%- assign is_fav = true -%}{%- endif -%}
            {%- assign cell = '' -%}
            {%- assign rank_ink = 'text--gray-40' -%}
            {%- assign name_ink = '' -%}
            {%- assign num_ink = '' -%}
            {%- assign gp_ink = 'text--gray-30' -%}
            {%- if is_fav -%}
              {%- assign cell = 'bg--black' -%}
              {%- assign rank_ink = 'text--white' -%}
              {%- assign name_ink = 'text--white text--bold' -%}
              {%- assign num_ink = 'text--white' -%}
              {%- assign gp_ink = 'text--white' -%}
            {%- endif -%}
            {%- assign edge = '' -%}
            {%- if row.cuttop == 1 and zones_on -%}{%- assign edge = 'border--top' -%}{%- endif -%}
            {%- comment -%} END rowvars {%- endcomment -%}
            <tr>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small value--tnums {{ rank_ink }}">{{ row.r }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small {{ name_ink }}" data-clamp="1">{{ row.full }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small value--tnums text--right {{ gp_ink }}">{{ row.gp }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small value--tnums text--right {{ num_ink }}">{{ row.gd }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small text--bold value--tnums text--right {{ num_ink }}">{{ row.pts }}</span></td>
            </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div>
        <table class="table table--xsmall lg:table--small">
          <thead>
            <tr>
              <th class="w--6"><span class="label label--small text--gray-40">#</span></th>
              <th><span class="label label--small text--gray-40">Team</span></th>
              <th class="w--8"><span class="label label--small text--gray-40 text--right">P</span></th>
              <th class="w--10"><span class="label label--small text--gray-40 text--right">GD</span></th>
              <th class="w--10"><span class="label label--small text--gray-40 text--right">Pts</span></th>
            </tr>
          </thead>
          <tbody>
            {%- for row in teams offset: 18 -%}
            {%- comment -%} BEGIN rowvars — generated from src/_rowvars.inc, do not edit here {%- endcomment -%}
            {%- comment -%}
              Per-row presentation variables.
              Kept as assigns so no Liquid sits in an HTML tag-open or attribute position — the visual
              editor cannot round-trip that. Zone cut lines use the framework's border--top class on the
              first row of each new zone, so no custom CSS is needed.
            {%- endcomment -%}
            {%- assign is_fav = false -%}
            {%- if row.fv == 1 -%}{%- assign is_fav = true -%}{%- endif -%}
            {%- assign cell = '' -%}
            {%- assign rank_ink = 'text--gray-40' -%}
            {%- assign name_ink = '' -%}
            {%- assign num_ink = '' -%}
            {%- assign gp_ink = 'text--gray-30' -%}
            {%- if is_fav -%}
              {%- assign cell = 'bg--black' -%}
              {%- assign rank_ink = 'text--white' -%}
              {%- assign name_ink = 'text--white text--bold' -%}
              {%- assign num_ink = 'text--white' -%}
              {%- assign gp_ink = 'text--white' -%}
            {%- endif -%}
            {%- assign edge = '' -%}
            {%- if row.cuttop == 1 and zones_on -%}{%- assign edge = 'border--top' -%}{%- endif -%}
            {%- comment -%} END rowvars {%- endcomment -%}
            <tr>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small value--tnums {{ rank_ink }}">{{ row.r }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small {{ name_ink }}" data-clamp="1">{{ row.full }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small value--tnums text--right {{ gp_ink }}">{{ row.gp }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small value--tnums text--right {{ num_ink }}">{{ row.gd }}</span></td>
              <td class="{{ cell }} {{ edge }}"><span class="label label--small text--bold value--tnums text--right {{ num_ink }}">{{ row.pts }}</span></td>
            </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

    </div>
  {%- endif -%}
</div>
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">{{ comp }}</span>
  <span class="instance">{{ phase }} &middot; Matchday {{ matchday }} &middot; {{ season }}</span>
</div>
